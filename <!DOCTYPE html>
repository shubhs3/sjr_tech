<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="pageTitle">Product Specification | SJR TECH Industries</title>
  <meta name="description" content="Detailed engineering specifications, pressure ratings, material options, and product range for SJR TECH Industries products.">
  <link rel="stylesheet" href="styles.css">
  <style>
    .product-page-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 7rem 2rem 5rem;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }
    .breadcrumb a {
      color: var(--accent-gold);
    }
    .product-detail-grid {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 3rem;
      align-items: start;
      margin-bottom: 3rem;
    }
    .product-detail-img-box {
      background: var(--bg-card);
      border: 1px solid var(--border-gold);
      border-radius: var(--radius-lg);
      padding: 1rem;
      box-shadow: var(--shadow-card);
      position: sticky;
      top: 6rem;
    }
    .product-detail-img {
      width: 100%;
      height: 340px;
      object-fit: cover;
      border-radius: var(--radius-md);
    }
    .product-detail-header {
      margin-bottom: 2rem;
    }
    .product-detail-title {
      font-family: var(--font-display);
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }
    .product-detail-summary {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .action-group {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .doc-section {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 2rem;
      margin-bottom: 2rem;
    }
    .doc-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--accent-gold);
      margin-bottom: 1.25rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    @media (max-width: 992px) {
      .product-detail-grid {
        grid-template-columns: 1fr;
      }
      .product-detail-img-box {
        position: static;
      }
    }
  </style>
</head>
